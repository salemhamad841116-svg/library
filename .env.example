# ==============================================================================
# Misruq Platform Environment Variables (.env)
# ==============================================================================

# Server Network & Port
PORT=3002
NODE_ENV=production

# Domains Configuration
# Public conversational bot domain (zero admin surface, isolated)
BOT_PUBLIC_DOMAIN="bot.misruq.com"
# Books & Notes management and Unified Admin panel domains (comma-separated)
ADMIN_BOOKS_DOMAIN="library.misruq.com,library-mgt.misruq.com"

# Local SQLite Data Directory (stores platform.db and audio voice replies)
PLATFORM_DATA_DIR="./data"

# ------------------------------------------------------------------------------
# Live Sync Bridge from waraqa.misruq.com (masruq_rag_backend)
# ------------------------------------------------------------------------------
# Absolute path to Waraqa's SQLite database mounted strictly read-only (:ro)
# In Docker: /mnt/waraqa/platform.db
WARAQA_DB_PATH="/mnt/waraqa/platform.db"

# Background Polling Interval (in milliseconds, default: 15000 = 15 seconds)
WARAQA_SYNC_INTERVAL_MS=15000

# Optional table name overrides (auto-discovery handles default schemas)
# WARAQA_BOOKS_TABLE="documents"
# WARAQA_QA_TABLE="bot_qa_rules"

# Secret token for real-time push webhook (POST /api/internal/waraqa-sync)
# Must match X-Waraqa-Sync-Secret header sent from masruq_rag_backend
WARAQA_SYNC_SECRET="YOUR_RANDOM_SECRET_FOR_WARAQA_SYNC"

# ------------------------------------------------------------------------------
# AI LLM Providers & Keys
# ------------------------------------------------------------------------------
# Gemini AI
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI (optional fallback)
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Anthropic Claude (optional fallback)
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# Secret key for encrypting provider keys stored in SQLite API vault (AES-256-GCM)
# If left empty, a permanent secret is auto-generated inside PLATFORM_DATA_DIR/.vault_secret
# API_VAULT_SECRET="your-32-byte-hex-secret-here"

# ------------------------------------------------------------------------------
# Firebase Configuration (for client app authentication if used)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# APP_URL: The URL where this app is hosted
APP_URL="https://library.misruq.com"

# RESEND_API_KEY: Used for transactional emails
RESEND_API_KEY="YOUR_RESEND_API_KEY"
